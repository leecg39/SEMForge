# @TASK P1-D1-T1 - SEMForge paid beta server environment contract
# 실제 비밀값은 .env.local 또는 배포 secret manager에만 저장합니다.

NODE_ENV=development
# production runtime에서는 web|worker|relay|scheduler|privacy|retention|migrate|operator 중 하나만 지정합니다.
SEMFORGE_SERVICE=all
APP_PUBLIC_URL=http://localhost:3000
# production web은 nginx가 두 header를 client 입력 대신 덮어쓰는 구성에서만 true로 시작합니다.
# 앱은 오른쪽 XFF hop과 X-Real-IP가 일치할 때만 원격 IP throttle bucket을 사용합니다.
AUTH_TRUST_PROXY_HEADERS=false

# PostgreSQL 16 application connection. production에서는 TLS를 사용합니다.
DATABASE_URL=postgresql://semforge_web_login:change-me@localhost:5432/semforge
# semforge_*는 NOLOGIN 권한 그룹입니다. IaC가 각 그룹을 상속하는 *_login 계정을 별도로 발급합니다.
# DDL owner, auth, operator, worker, billing은 web login 계정을 재사용하지 않습니다.
AUTH_DATABASE_URL=postgresql://semforge_auth_login:change-me@localhost:5432/semforge
# `npm run invite -- ...`와 `npm run privacy:request -- ...` 승인 CLI에서만 주입합니다.
# web/privacy/retention/worker 프로세스에는 주입하지 않습니다.
OPERATOR_DATABASE_URL=postgresql://semforge_operator_login:change-me@localhost:5432/semforge
WORKER_DATABASE_URL=postgresql://semforge_worker_login:change-me@localhost:5432/semforge
DISPATCHER_DATABASE_URL=postgresql://semforge_dispatcher_login:change-me@localhost:5432/semforge
SCHEDULER_DATABASE_URL=postgresql://semforge_scheduler_login:change-me@localhost:5432/semforge
# Toss webhook·조회 대사용 global 역할입니다. tenant 사용자 요청에 사용하지 않습니다.
BILLING_DATABASE_URL=postgresql://semforge_billing_login:change-me@localhost:5432/semforge
# 사용자 결제 요청용 역할이며 app.workspace_id RLS가 적용됩니다.
BILLING_TENANT_DATABASE_URL=postgresql://semforge_billing_tenant_login:change-me@localhost:5432/semforge
PRIVACY_DATABASE_URL=postgresql://semforge_privacy_login:change-me@localhost:5432/semforge
# 보존기간 전용 최소권한 역할입니다. privacy 수동 DSAR 역할과 공유하지 않습니다.
PRIVACY_RETENTION_DATABASE_URL=postgresql://semforge_retention_login:change-me@localhost:5432/semforge
MIGRATION_DATABASE_URL=postgresql://semforge_owner_login:change-me@localhost:5432/semforge
PGPOOL_MAX=10
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PGPOOL_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
PGSSLMODE=disable

# AES-256-GCM current key and key id. APP_SECRET은 32자 이상이어야 합니다.
APP_SECRET=
APP_SECRET_CURRENT_KEY_ID=key-2026-08
# 이전 키 회전용 JSON object: {"key-2026-07":"previous-secret-at-least-32-characters"}
APP_SECRET_PREVIOUS_KEYS={}

# Core provider credentials. 실제 production 값은 배포 secret manager에서 주입합니다.
TALORDATA_API_TOKEN=
# NAVER 공식 Open API (DataLab/Search API)와 Search Ads 자격증명입니다.
NAVER_OPEN_API_CLIENT_ID=
NAVER_OPEN_API_CLIENT_SECRET=
NAVER_SEARCH_AD_ACCESS_LICENSE=
NAVER_SEARCH_AD_SECRET_KEY=
NAVER_SEARCH_AD_CUSTOMER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gsc/callback
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
BILLING_FINGERPRINT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SEMForge <reports@example.com>
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Chromium/Chrome executable bundled in the worker image.
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# 유료 production web/all 전용 공개 법률 manifest입니다. 비밀값은 아니지만 승인된 실제 값은
# 저장소에 커밋하지 않습니다. build/worker/relay/scheduler/migrate에는 필요하지 않습니다.
# 템플릿과 승인 절차: docs/release/legal-launch-gate.md
# JSON은 `jq -c`로 한 줄 직렬화하고, status/attestation은 최종 법률·운영 승인 뒤에만 바꿉니다.
LEGAL_RELEASE_MANIFEST=
PRIVACY_RETENTION_POLICY=
