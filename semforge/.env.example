# @TASK P1-D1-T1 - SEMForge paid beta server environment contract
# 실제 비밀값은 .env.local 또는 배포 secret manager에만 저장합니다.

NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3000

# PostgreSQL 16 application connection. production에서는 TLS를 사용합니다.
DATABASE_URL=postgresql://semforge:change-me@localhost:5432/semforge
# DDL owner와 worker는 web role 계정을 재사용하지 않습니다.
AUTH_DATABASE_URL=postgresql://semforge_auth:change-me@localhost:5432/semforge
WORKER_DATABASE_URL=postgresql://semforge_worker:change-me@localhost:5432/semforge
MIGRATION_DATABASE_URL=postgresql://semforge_owner:change-me@localhost:5432/semforge
PGPOOL_MAX=10
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PGPOOL_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
PGSSLMODE=disable

# AES-256-GCM current key and key id. APP_SECRET은 32자 이상이어야 합니다.
APP_SECRET=
APP_SECRET_CURRENT_KEY_ID=key-2026-08
# 이전 키 회전용 JSON object: {"key-2026-07":"previous-secret-at-least-32-characters"}
APP_SECRET_PREVIOUS_KEYS={}

# Core provider credentials. production 검증은 각 기능 출시 시 해당 adapter에서 수행합니다.
TALORDATA_API_TOKEN=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_SEARCH_AD_ACCESS_LICENSE=
NAVER_SEARCH_AD_SECRET_KEY=
NAVER_SEARCH_AD_CUSTOMER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gsc/callback
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
RESEND_API_KEY=
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
