# TalorData SERP API 토큰 (https://dashboard.talordata.com/user-center 에서 확인)
TALORDATA_API_TOKEN=

# NAVER API HUB (신규 NAVER Search/Search Trend 연동). 서버에서만 사용합니다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# NAVER Search Ads RelKwdStat 공용 계정 자격증명. 응답·로그·클라이언트 번들에 노출하지 않습니다.
NAVER_SEARCH_AD_ACCESS_LICENSE=
NAVER_SEARCH_AD_SECRET_KEY=
NAVER_SEARCH_AD_CUSTOMER_ID=

# 공개 네이버 키워드 도구 익명 사용량 HMAC/쿠키 서명 키.
# production에서는 반드시 충분히 긴 무작위 값으로 설정합니다.
PUBLIC_RATE_LIMIT_SECRET=

# 네이버 키워드 인텔리전스 기능 플래그와 일일 공급자 안전 한도.
NAVER_KEYWORD_INTELLIGENCE_ENABLED=false
PUBLIC_NAVER_KEYWORD_PREVIEW_ENABLED=false
NAVER_SEARCH_AD_DAILY_BUDGET=1000
NAVER_API_HUB_DAILY_BUDGET=10000

# Bing Webmaster 읽기 전용 OAuth. 등록한 콜백 URI와 정확히 일치해야 합니다.
BING_WEBMASTER_CLIENT_ID=
BING_WEBMASTER_CLIENT_SECRET=
BING_WEBMASTER_REDIRECT_URI=http://localhost:3000/api/bing-webmaster/callback

# Ahrefs 무료 Domain Rating API 키. 서버 전용 Bearer 인증에만 사용합니다.
AHREFS_API_KEY=

# 공식 Common Crawl Web Graph/WARC를 역색인한 서버 전용 게이트웨이.
# 게이트웨이는 POST { siteUrl, targetUrl, scope, limit, recentCrawls, verifyWarcLinks }를 받는다.
COMMON_CRAWL_BACKLINK_ENDPOINT=
COMMON_CRAWL_BACKLINK_TOKEN=

# ChatGPT 웹 검색 기반 인용 순위 수집. 키는 서버에서만 사용되며 클라이언트 응답에 포함되지 않습니다.
OPENAI_API_KEY=
OPENAI_POSITION_MODEL=gpt-5.6

# 광고·콘텐츠 AI는 OpenAI API 키 대신 ChatMock으로 로그인한 ChatGPT 계정을 사용합니다.
# 먼저 `chatmock login`, 이어서 `chatmock serve`를 실행하세요.
CHATMOCK_BASE_URL=http://127.0.0.1:8000/v1
CHATMOCK_ADVERTISING_MODEL=gpt-5.4
CHATMOCK_CONTENT_MODEL=gpt-5.6-luna
CHATMOCK_CONTENT_TIMEOUT_MS=270000

# 콘텐츠 생성 모델 드롭다운과 영상 콘티 Grok 4.5를 활성화합니다.
# XAI_API_KEY 등호 뒤에 키를 직접 입력한 다음 서버를 다시 시작하세요.
XAI_API_KEY=
XAI_CONTENT_MODEL=grok-4.5
XAI_VIDEO_MODEL=grok-imagine-video-1.5

# 이미지와 영상 키프레임은 ChatMock이 비주얼 명세를 만들고 서버가 로컬에서 렌더링합니다.
# 기본 저장 위치는 data/content-assets 입니다.
CONTENT_ASSET_ROOT=

# 미설정 시 PATH의 ffmpeg/ffprobe를 사용합니다.
FFMPEG_PATH=
FFPROBE_PATH=

# Gemini Google Search grounding 기반 인용 순위 수집 및 콘텐츠 생성.
GEMINI_API_KEY=
GEMINI_POSITION_MODEL=gemini-2.5-flash

# TalorData 계약 환경에서 태블릿 요청을 검증한 경우에만 true로 활성화합니다.
POSITION_TRACKING_TABLET_ENABLED=false

# Firecrawl API 키 (https://www.firecrawl.dev/app/api-keys 에서 확인) — 사이트 감사 크롤 엔진 (없으면 자체 크롤러 사용)
FIRECRAWL_API_KEY=

# PageSpeed Insights API 키 (없어도 저쿼터로 동작) — Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보에서 API 키 발급 (https://console.cloud.google.com/apis/credentials)
PAGESPEED_API_KEY=

# Google OAuth 클라이언트 — Google Cloud 콘솔에서 "웹 애플리케이션" 유형 OAuth 클라이언트 생성 후 발급, Search Console API 활성화 필요 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GSC OAuth 리디렉션 URI — 위 OAuth 클라이언트의 "승인된 리디렉션 URI" 에 동일하게 등록 (기본값 http://localhost:3000/api/gsc/callback)
GSC_REDIRECT_URI=

# GBP(Google Business Profile) OAuth 리디렉션 URI — 같은 OAuth 클라이언트에 추가 등록 (기본값 http://localhost:3000/api/gbp/callback). Business Profile API 계열 활성화 필요
GBP_REDIRECT_URI=

# /api/cron/run-due 외부 트리거 보호용 비밀값 (설정 시 x-cron-secret 헤더 검증)
CRON_SECRET=

# 스냅샷 테이블(serp/ai_visibility/map_rank) 보존 일수 — db_retention job 이 초과분을 정리 (기본 90)
SNAPSHOT_RETENTION_DAYS=

# OAuth 토큰 at-rest 암호화 키 재료 (임의의 긴 문자열). 미설정 시 평문 저장 + 서버 로그 경고
APP_SECRET=
# 소셜 미디어 툴킷 (Meta + 공개 이미지 발행)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/social/connections/meta/callback/
META_GRAPH_API_VERSION=v23.0
APP_PUBLIC_URL=
SOCIAL_LIVE_PUBLISH_ENABLED=false
SOCIAL_ASSET_ROOT=./data/social-assets

# Airbyte Cloud + 별도 Postgres 마케팅 데이터 계층. 모두 서버 전용입니다.
AIRBYTE_API_TOKEN=
AIRBYTE_ORGANIZATION_ID=
# Airbyte destination 전용 writer 계정. raw namespace에만 쓰기 권한을 부여합니다.
AIRBYTE_DESTINATION_DATABASE_URL=
# 변환 잡 전용 계정. raw 읽기·보존 삭제와 marketing fact/mart 쓰기 권한을 부여합니다.
ANALYTICS_TRANSFORM_DATABASE_URL=
# SEMForge 앱 전용 reader 계정. marketing mart SELECT 권한만 부여합니다.
ANALYTICS_DATABASE_URL=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
MARKETING_REPORT_ASSET_ROOT=./data/marketing-reports

# 단계별 출시 플래그. 먼저 ingestion/intelligence만 내부 PoC에서 활성화하세요.
AIRBYTE_MARKETING_INGESTION_ENABLED=false
MARKETING_INTELLIGENCE_ENABLED=false
MARKETING_SELF_SERVICE_CONNECTIONS_ENABLED=false
MARKETING_ADS_ENABLED=false
MARKETING_CRM_ENABLED=false
MARKETING_REPORT_PDF_ENABLED=false
