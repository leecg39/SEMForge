# 실제 키는 .env.local에만 넣고, 실제 값을 이 예제 파일에 입력하거나 커밋하지 마세요.
TALORDATA_API_TOKEN=
FIRECRAWL_API_KEY=
# 선택: Firecrawl 셀프호스트/호환 API. 기본값 https://api.firecrawl.dev/v2
FIRECRAWL_API_BASE_URL=
PAGESPEED_API_KEY=

# Google Search Console / Business Profile OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:3000/api/gsc/callback
GBP_REDIRECT_URI=http://localhost:3000/api/gbp/callback

# 서버 비밀값
APP_SECRET=
CRON_SECRET=
SNAPSHOT_RETENTION_DAYS=90
