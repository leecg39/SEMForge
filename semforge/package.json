    "test:ai-visibility": "tsx --test src/components/app/toolkit-navigation.test.ts src/server/ai-search/providers.test.ts src/server/ai-visibility/dashboard.test.ts src/server/ai-visibility/projects.test.ts src/server/ai-visibility/brand-performance.test.ts src/server/ai-visibility/competitor-research.test.ts src/server/ai-visibility/prompt-research.test.ts",
