    "test:content": "tsx --test src/server/content/contracts.test.ts src/server/content/generation-providers.test.ts src/server/content/scoring.test.ts src/server/content/runs.test.ts src/server/content/visual-storage.test.ts src/server/content/visual-renderer.test.ts src/server/content/visuals.test.ts src/server/content/media-prompts.test.ts src/server/content/happyhorse.test.ts src/server/content/xai-video.test.ts src/server/content/video-renderer.test.ts src/server/content/media.test.ts src/server/content/media-due.test.ts src/server/content/packages.test.ts",
    "test:social": "tsx --test src/components/app/toolkit-navigation.test.ts src/server/social/overview.test.ts src/server/social/workflow.test.ts src/server/social/media.test.ts src/server/social/providers.test.ts",
    "content:migrate-svg": "tsx scripts/convert-content-package-assets-to-svg.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:cleanup:demo": "tsx scripts/db-cleanup-demo.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:analytics": "SEED_DEMO_DATA=1 tsx src/db/seed-analytics-cli.ts",
    "db:reset": "rm -rf data && npm run db:migrate && npm run db:seed",
    "chatmock:login": "chatmock login",
    "chatmock:serve": "chatmock serve"
