{
  "name": "semforge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "nanoid": "3.3.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/**/*.test.ts\"",
    "test:db": "tsx --test src/db/**/*.test.ts src/lib/crypto.test.ts src/lib/env.test.ts",
    "test:providers": "tsx --test src/server/talordata/client.test.ts src/server/providers/naver/*.test.ts src/server/naver-search-ads/client.test.ts",
    "test:pg16": "tsx --test src/db/postgres16.multisession.pg16.ts",
    "test:pg16:docker": "bash scripts/test-pg16.sh",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "worker:start": "tsx scripts/worker.ts",
    "outbox:relay": "tsx scripts/outbox-relay.ts",
    "collections:schedule": "tsx scripts/weekly-collections.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
