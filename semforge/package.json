{
  "name": "semforge",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "SEMFORGE_SERVICE=build next build",
    "start": "next start",
    "start:worker": "node --import tsx scripts/ops/worker.ts",
    "start:relay": "node --import tsx scripts/ops/relay.ts",
    "start:scheduler": "node --import tsx scripts/ops/scheduler.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/**/*.test.ts\"",
    "test:ops": "tsx --test \"src/server/health/*.test.ts\" \"src/server/observability/*.test.ts\" \"scripts/ops/*.test.ts\" \"scripts/ops/*.test.mjs\"",
    "test:db": "tsx --test src/db/**/*.test.ts src/lib/crypto.test.ts src/lib/env.test.ts",
    "test:providers": "tsx --test src/server/talordata/client.test.ts src/server/providers/naver/*.test.ts src/server/naver-search-ads/client.test.ts",
    "test:pg16": "tsx --test src/db/postgres16.multisession.pg16.ts",
    "test:pg16:privacy": "tsx --test src/db/privacy-barrier.pg16.ts",
    "test:pg16:docker": "bash scripts/test-pg16.sh",
    "deploy:preflight": "node scripts/ops/deployment-preflight.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "license:generate": "node scripts/license/generate-third-party-notices.mjs",
    "license:check": "node scripts/license/generate-third-party-notices.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "invite": "SEMFORGE_SERVICE=operator tsx scripts/invite.ts",
    "privacy:retention": "SEMFORGE_SERVICE=retention sh scripts/ops/docker-entrypoint.sh privacy-retention",
    "privacy:export": "SEMFORGE_SERVICE=privacy sh scripts/ops/docker-entrypoint.sh privacy-export",
    "privacy:correct": "SEMFORGE_SERVICE=privacy sh scripts/ops/docker-entrypoint.sh privacy-correct",
    "privacy:delete": "SEMFORGE_SERVICE=privacy sh scripts/ops/docker-entrypoint.sh privacy-delete",
    "privacy:request": "SEMFORGE_SERVICE=operator sh scripts/ops/docker-entrypoint.sh privacy-request",
    "worker:start": "tsx scripts/worker.ts",
    "outbox:relay": "tsx scripts/outbox-relay.ts",
    "collections:schedule": "tsx scripts/weekly-collections.ts",
    "ci:release-gate": "node scripts/ci/run-release-gate.mjs",
    "ci:route-manifest": "node scripts/ci/route-manifest.mjs",
    "ci:forbidden-surface": "node scripts/ci/forbidden-surface.mjs",
    "ci:nine-site": "node scripts/ci/nine-site-harness.mjs",
    "ci:pg16": "bash scripts/test-pg16.sh"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@tosspayments/tosspayments-sdk": "^2.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
