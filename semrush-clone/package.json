{
  "name": "semrush-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:analytics": "tsx --test src/lib/analytics/metrics.test.ts",
    "test:talordata": "tsx --test src/server/talordata/client.test.ts",
